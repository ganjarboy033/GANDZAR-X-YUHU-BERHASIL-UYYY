# Buat OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Wajib, minimal 32 karakter acak. Buat dengan: openssl rand -base64 32
SESSION_PASSWORD=
# Opsional. Biasanya dikosongkan: URL diambil otomatis dari domain yang dibuka.
# Callback URL di GitHub tetap harus: https://DOMAIN-KAMU/api/auth/github/callback
APP_URL=
